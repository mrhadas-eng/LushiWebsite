// Cloudflare Workers configuration (see docs/CLOUDFLARE-PLAN.md).
// The Astro build in ./dist is served as static assets; only /api/* runs the Worker.
// Secrets (never in this file): CRM_WEBHOOK_URL, and optionally CRM_AUTH_HEADER.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hagarlushi",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Keep the Wix URLs: /אודות is served directly, /אודות/ redirects to /אודות.
    // (The default, auto-trailing-slash, would redirect every page to a trailing-slash URL.)
    "html_handling": "drop-trailing-slash",
    // Unknown URLs get dist/404.html with status 404.
    "not_found_handling": "404-page",
    // Only the lead endpoint runs code; everything else is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Body format the CRM webhook expects: "json" or "form" (application/x-www-form-urlencoded).
    "CRM_FORMAT": "json"
  },
  "observability": { "enabled": true }
}
