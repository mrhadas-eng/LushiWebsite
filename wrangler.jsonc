// Cloudflare Workers configuration (see docs/CLOUDFLARE-PLAN.md).
// The Astro build in ./dist is served as static assets; only /api/* runs the Worker.
// Secrets (never in this file or anywhere in the repo), set on the Worker in the Cloudflare dashboard:
//   CRM_WEBHOOK_URL        OfficeCRM leads webhook address
//   LEADS_WEBHOOK_API_KEY  OfficeCRM's LEADS_WEBHOOK_API_KEY value (bare key, no "Bearer ")
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hagarlushi",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Keep the Wix URLs: /אודות is served directly, /אודות/ redirects to /אודות.
    // (The default, auto-trailing-slash, would redirect every page to a trailing-slash URL.)
    "html_handling": "drop-trailing-slash",
    // Unknown URLs get dist/404.html with status 404.
    "not_found_handling": "404-page",
    // Only the lead endpoint runs code; everything else is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // No public <name>.<subdomain>.workers.dev address (owner, 2026-10-28): the site is reached only through the
  // www Custom Domain, attached in the Cloudflare dashboard (no "routes" here, so deploys leave it in place).
  // Without this line every `wrangler deploy` re-enables workers.dev. Preview URLs (preview_urls) are left unchanged.
  "workers_dev": false,
  // Previews intentionally have no CRM secrets or production bindings.
  "previews": {},
  // Local preview only (`npm run preview:cf`). Pinned so it never collides with the lp preview (8788):
  // when both use the default 8787, wrangler silently moves the second one to another port.
  "dev": { "port": 8787, "inspector_port": 9229 }
}
