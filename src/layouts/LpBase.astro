---
// Layout for the landing pages served on lp.hagarlushi.com (second Worker, see wrangler.lp.jsonc).
// Mirrors the WordPress/Elementor pages: transparent header with the logo, black footer, floating
// WhatsApp button that opens the name/phone pop-up, GTM + the Site Kit Google tag.
import Tracking from '../components/Tracking.astro';
import LpWhatsApp from '../components/lp/LpWhatsApp.astro';
import { lpSite, lpImg } from '../data/lp.mjs';
import { lpHref } from '../lib/lp-paths.mjs';

interface Props { title: string; path: string; noindex?: boolean; bodyClass?: string }
const { title, path, noindex = false, bodyClass } = Astro.props;
const canonical = `${lpSite.origin}${path}`;
const logo = lpImg('2025/02/LOGO.png');
const logoWhite = lpImg('2025/02/LOGO-white-2.png');
const fav = lpImg('2025/02/fav.png');
const siteKitId = lpSite.siteKitTagId;
---
<!doctype html>
<html lang="he-IL" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Tracking />
    <!-- Google tag added by WordPress Site Kit on the old site (GT-TQKZV73G), kept as-is.
         Loaded on the real domain only, like GTM (?gtm=1 enables it on previews). -->
    <script is:inline define:vars={{ siteKitId }}>
      (function () {
        var live = /(^|\.)hagarlushi\.com$/.test(location.hostname), forced = false;
        try { forced = sessionStorage.getItem('hl_gtm') === '1'; } catch (e) {}
        if (!live && !forced) return;
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { dataLayer.push(arguments); };
        gtag('set', 'linker', { domains: ['lp.hagarlushi.com'] });
        gtag('js', new Date());
        gtag('config', siteKitId);
        var s = document.createElement('script');
        s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + siteKitId;
        document.head.appendChild(s);
      })();
    </script>
    <title>{title}</title>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={fav.src} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&family=Noto+Sans+Hebrew:wght@400;600&display=swap" />
  </head>
  <body class:list={['lp', bodyClass]}>
    <a class="lp-skip" href="#main">לדלג לתוכן הראשי</a>
    <header class="lp-header">
      <a href={lpHref('/')} aria-label="הגר לושי – דף הבית">
        <img src={logo.src} alt="Hagar Lushi" width="250" height={logo.height && logo.width ? Math.round(250 * logo.height / logo.width) : undefined} />
      </a>
    </header>
    <main id="main"><slot /></main>
    <footer class="lp-footer">
      <img src={logoWhite.src} alt="Hagar Lushi" width="200" loading="lazy" />
      <p>{lpSite.footer.rights} | <a href={lpHref('/accessibility-statement/')}>הצהרת נגישות</a> | <a href={lpHref('/privacy/')}>מדיניות פרטיות</a></p>
    </footer>
    <LpWhatsApp />
  </body>
</html>

<style is:global>
  .lp {
    --lp-ink: #141414; --lp-text: #333; --lp-soft: #f9f9fa; --lp-green: rgb(63, 100, 75);
    --lp-font: 'Open Sans', 'Noto Sans Hebrew', Arial, sans-serif;
    margin: 0; background: #fff; color: var(--lp-text); direction: rtl;
    font-family: var(--lp-font); font-size: 16px; line-height: 1.5;
  }
  .lp *, .lp *::before, .lp *::after { box-sizing: border-box; }
  .lp img { max-width: 100%; display: block; }
  .lp a { color: inherit; }
  .lp .visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .lp-skip { position: absolute; inset-inline-start: 8px; top: -60px; background: #fff; color: #000; padding: 8px 14px; z-index: 100; }
  .lp-skip:focus { top: 8px; }
  .lp :focus-visible { outline: 3px solid #1a73e8; outline-offset: 2px; }
  /* WordPress: a 140px header with the 250px logo 10px from the top; a black 195px footer with the 200px white logo
     40px down and one #d8d8d8 line (Noto Sans Hebrew 15/22.5px) 25px under it. */
  .lp-header { min-height: 140px; display: flex; align-items: flex-start; justify-content: center; padding: 10px 10px 0; position: relative; z-index: 1; box-shadow: 0 0 30px rgba(0, 0, 0, .1); }
  .lp-header img { width: 250px; height: auto; }
  .lp-footer { background: #000; color: #d8d8d8; text-align: center; min-height: 195px; padding: 40px 20px 20px; display: grid; justify-items: center; align-content: start; gap: 25px; }
  .lp-footer img { width: 200px; height: auto; }
  .lp-footer p { margin: 0; font-family: 'Noto Sans Hebrew', var(--lp-font); font-size: 15px; line-height: 22.5px; }
  .lp-footer a { text-decoration: none; border-bottom: 1px dotted #d8d8d8; }
  .lp-footer a:hover { border-bottom-style: solid; }
  @media (pointer: coarse) { .lp-footer a { display: inline-block; padding-block: 12px; margin-block: -12px; } }
  @media (max-width: 767px) {
    .lp-header { min-height: 100px; } .lp-header img { width: 170px; }
    .lp-footer { min-height: 199px; gap: 40px; } .lp-footer img { width: 160px; } .lp-footer p { font-size: 14px; line-height: 21px; max-width: 190px; }
  }
  /* Legal pages (the exported Elementor markup), as on WordPress: 70px above the first block, content 1140px wide,
     the page title Noto Sans Hebrew 32/41.6px 600 centred, headings in the text 32/38.4px 500, paragraphs 17/25.5px
     with 14.4px between them. */
  .lp-legal { color: var(--lp-ink); font-size: 17px; line-height: 25.5px; }
  .lp-legal > div > .e-con { padding: 70px 20px; }
  .lp-legal > div > .e-con + .e-con { padding-top: 10px; }
  .lp-legal .e-con-inner { max-width: 1140px; margin: 0 auto; }
  .lp-legal .elementor-widget-heading h2 { margin: 0 0 40px; font-family: 'Noto Sans Hebrew', var(--lp-font); font-size: 32px; line-height: 41.6px; font-weight: 600; text-align: center; }
  .lp-legal .elementor-widget-text-editor h1, .lp-legal .elementor-widget-text-editor h2, .lp-legal .elementor-widget-text-editor h3 { margin: 8px 0 16px; font-size: 32px; line-height: 38.4px; font-weight: 500; }
  .lp-legal p { margin: 0 0 14.4px; }
  .lp-legal a { text-decoration: underline; word-break: break-word; }
  .lp-legal img { display: none; }
  @media (max-width: 767px) {
    .lp-legal > div > .e-con { padding: 40px 20px; }
    .lp-legal .elementor-widget-heading h2, .lp-legal .elementor-widget-text-editor h2 { font-size: 26px; line-height: 34px; }
  }
  @media (prefers-reduced-motion: reduce) { .lp * { transition: none !important; animation: none !important; } }
</style>
