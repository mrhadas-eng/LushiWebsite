---
import Base from '../layouts/Base.astro';
import Slideshow from '../components/Slideshow.astro';
import ValueIcon from '../components/ValueIcon.astro';
import ContactForm from '../components/ContactForm.astro';
import Social from '../components/Social.astro';
import { home, site, galleries } from '../data/content.mjs';
import { img } from '../lib/media.mjs';

const mark = img(site.mark);
const quoteBg = img(home.quote.image, 1600);
const tasting = galleries.home;
// Wix shows the values left to right in this order (text x positions on Wix), with the text top per item
// (distance from the icon top, px).
const valueOrder = [[0, 65], [1, 73], [4, 71], [2, 67], [3, 62]].map(([n, top]) => ({ ...home.values[n], top, n }));
// Wix mobile: the values stacked in their original order; top of each icon in the 320px design (from the section top).
const mobileTop = [20, 188, 358, 498, 668];
---
<Base ogImage={home.slides[0].image}>
  <Slideshow slides={home.slides} />

  <!-- Intro -->
  <section class="intro reveal">
    <span class="mark-ring"><img class="mark" src={mark.src} alt="logo" width="80" height="80" /></span>
    <h2 class="h-spaced">{home.introTitle}</h2>
    <p class="intro-text">{home.intro}</p>
    <div class="intro-links">
      <a class="link-caps" href="/אודות">קראו עוד</a>
      <a class="link-caps" href="#gallery">צפו בגלריה</a>
    </div>
  </section>

  <!-- Values -->
  <section class="values reveal" aria-label="מה מקבלים">
    {valueOrder.map((v) => (
      <div class="value" style={`--t:${v.top}px;--o:${v.n};--mt:${mobileTop[v.n]}`}>
        <ValueIcon name={v.icon} />
        <h3 class="pre">{v.text}</h3>
      </div>
    ))}
  </section>

  <!-- Homes / Businesses -->
  {[home.homes, home.business].map((s, n) => {
    const [a, b] = s.images.map((im) => ({ ...img(im.id, 480), alt: im.alt }));
    return (
      <section class:list={['split', n === 0 ? 'split-homes' : 'split-business']}>
        <div class="split-in reveal">
          <div class="split-text">
            <h2 class="h-split">{s.title}</h2>
            <p class="body pre">{s.lead && <b>{s.lead}</b>}{s.lead && <br />}{s.text}</p>
            <a class="btn-dark" href={s.href}>צפו בפרויקטים</a>
          </div>
          <div class="split-img">
            <img class="si" src={a.src} srcset={a.srcset} sizes="(max-width: 760px) 88vw, 368px" alt={a.alt} width="368" height="523" loading="lazy" />
            <img class="si si-hover" src={b.src} srcset={b.srcset} sizes="(max-width: 760px) 88vw, 372px" alt={b.alt} width="372" height="532" loading="lazy" />
          </div>
        </div>
      </section>
    );
  })}

  <!-- Quote -->
  <section class="quote" lang="en" dir="ltr">
    <img src={quoteBg.src} srcset={quoteBg.srcset} sizes="100vw" alt="" loading="lazy" />
    <div class="quote-in reveal">
      <p class="q">{home.quote.text}</p>
      <p class="by">{home.quote.by}</p>
    </div>
  </section>

  <!-- Tasting gallery: a strip that moves one photo to the left every 4 seconds -->
  <section id="gallery" class="tasting" aria-labelledby="tasting-title">
    <h2 id="tasting-title" class="h-section reveal">{home.galleryTitle}</h2>
    <div class="t-view">
      <div class="t-track">
        {[...tasting, ...tasting].map((g, k) => {
          const t = img(g.id, 480);
          return <img src={t.src} srcset={t.srcset} sizes="354px" alt="" width="354" height="472" loading="lazy" aria-hidden={k >= tasting.length ? 'true' : undefined} />;
        })}
      </div>
      <button class="t-next" type="button" aria-label="התמונה הבאה"><svg width="23" height="39" viewBox="0 0 23 39" aria-hidden="true"><path d="M2.005 1.479L3.5 0l18.124 18-18.127 18-1.49-1.48L18.638 18Z" transform="translate(0 1.5)" fill="#fff" /></svg></button>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="contact-in reveal">
      <h2 id="contact-title" class="h-section">צרו קשר</h2>
      <div class="ci-row">
        <a class="ci ci-email" href={`mailto:${site.email}`} aria-label={site.emailDisplay}><span class="ci-t">{site.emailDisplay}</span><svg class="ci-i" viewBox="0 0 28 28" aria-hidden="true"><rect x="3" y="6.5" width="22" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M4 8l10 7.5L24 8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></a>
        <a class="ci ci-phone" href={site.phoneHref} dir="ltr" aria-label={site.phone}><span class="ci-t">{site.phone}</span><svg class="ci-i" viewBox="0 0 28 28" aria-hidden="true"><path d="M8.6 4.5h3.6l1.8 4.8-2.4 1.6a13 13 0 0 0 7 7l1.6-2.4 4.8 1.8v3.6c0 1-.8 1.8-1.8 1.8A19.5 19.5 0 0 1 6.8 6.3c0-1 .8-1.8 1.8-1.8z" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></a>
      </div>
      <div class="ci-social"><Social size={29} gap={9} order="fb-ig" /></div>
      <div class="ci-form"><ContactForm variant="home" /></div>
    </div>
  </section>
</Base>

<style>
  /* Measured on Wix at 1440px. Section heights: intro 434, values 231, homes 594, businesses 608, quote 635,
     tasting gallery 718, contact 784. Horizontal positions are given from the window centre (Wix's 980px page is
     centred). */
  .intro { min-height: 434px; padding: 84px 16px 40px; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .mark { width: 80px; height: 80px; }
  /* Wix draws a 93x100px ellipse (1px #414141) around the mark, 6px left and 10px above it. */
  .mark-ring { position: relative; display: block; }
  .mark-ring::before { content: ''; position: absolute; left: -6px; top: -10px; width: 93px; height: 100px; border: 1px solid #414141; border-radius: 50%; }
  .intro .h-spaced { margin-top: 42px; }
  .intro-text { width: min(935px, 100%); font-size: 18px; line-height: 25.2px; margin-top: 14px; }
  .intro-links { display: flex; gap: 72px; margin: 34px 8px 0 0; }

  /* Values: five 200px columns centred on the window, laid out left to right as on Wix; icons 34px below the
     section top, text at a per-item distance below the icon top. */
  .values { min-height: 231px; direction: ltr; display: grid; grid-template-columns: repeat(5, 1fr); width: min(1000px, 100% - 32px); margin-inline: auto; padding-top: 34px; text-align: center; color: var(--ink); }
  .value { direction: rtl; position: relative; display: flex; flex-direction: column; align-items: center; }
  .value h3 { position: absolute; top: var(--t); inset-inline: 0; font-size: 16px; line-height: 19.2px; }

  /* Text and photo side by side. Homes: text 502px wide from 515px left of centre, 89px gap, photo 368x523;
     businesses: photo from 474px left of centre, 144px gap, text 502px. Photo 23px below the section top; text
     135 / 150px. Hovering the photo fades to the second photo (0.4s), as on Wix. */
  .split-in { direction: ltr; display: grid; align-items: start; }
  .split-homes { min-height: 594px; }
  .split-business { min-height: 608px; }
  .split-homes .split-in { grid-template-columns: 502fr 89fr 368fr; width: 959px; margin-left: calc(50% - 515px); margin-right: auto; --text-top: 135px; }
  .split-business .split-in { grid-template-columns: 368fr 144fr 502fr; width: 1014px; margin-left: calc(50% - 474px); margin-right: auto; --text-top: 150px; }
  .split-homes .split-text { grid-column: 1; grid-row: 1; }
  .split-homes .split-img { grid-column: 3; grid-row: 1; }
  .split-business .split-img { grid-column: 1; grid-row: 1; }
  .split-business .split-text { grid-column: 3; grid-row: 1; }
  .split-text { direction: rtl; padding-top: var(--text-top); display: flex; flex-direction: column; align-items: flex-start; }
  .split-text .h-split { line-height: 35px; }
  .split-text .body { font-size: 18px; line-height: 25.2px; text-align: justify; margin-top: 19px; }
  .split-text .body b { font-weight: 700; }
  .split-text .btn-dark { margin-top: 20px; width: 142px; height: 40px; padding: 0; display: grid; place-items: center; background: #282626; font-size: 15px; letter-spacing: .75px; }
  .split-img { position: relative; margin-top: 23px; aspect-ratio: 368 / 523; }
  .si { width: 100%; height: 100%; object-fit: cover; transition: opacity .4s ease-in-out; }
  .si-hover { position: absolute; left: 0; top: -5px; width: calc(100% + 4px); height: calc(100% + 9px); opacity: 0; }
  .split-img:hover .si-hover { opacity: 1; }

  /* Quote: #041f3e band with the photo at 66% opacity; Brandon Grotesque Light (Josefin Sans here) 45/63 and 30/42. */
  .quote { position: relative; height: 635px; display: grid; place-items: center; overflow: hidden; color: #fff; text-align: center; background: #041f3e; }
  .quote > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .66; }
  .quote-in { position: relative; z-index: 1; padding: 0 24px; font-family: var(--font-brandon); font-weight: 300; }
  .q { font-size: 45px; line-height: 63px; max-width: 1100px; }
  .by { font-size: 30px; line-height: 42px; }

  /* Tasting gallery: #fafafa band; title 83px below its top; the strip 1216px wide (354x472 photos, 10px apart)
     35px below the title; white arrow 23px from the strip's right edge. */
  .tasting { min-height: 718px; background: var(--soft); padding: 83px 0 40px; }
  .tasting h2 { line-height: normal; }
  .t-view { position: relative; width: min(1216px, 100% - 32px); margin: 35px auto 0; overflow: hidden; direction: ltr; }
  .t-track { display: flex; gap: 10px; width: max-content; }
  .t-track.moving { transition: transform .6s ease-in-out; }
  .t-track img { width: 354px; height: 472px; object-fit: cover; flex: none; }
  .t-next { position: absolute; right: 23px; top: 216px; width: 23px; height: 39px; padding: 0; border: 0; background: none; cursor: pointer; }
  @media (pointer: coarse) { .t-next { width: 44px; height: 56px; right: 13px; top: 208px; display: grid; place-items: center; } }

  /* Contact: centred 8.5px right of the window centre; title 95px below the section top; e-mail (right-aligned,
     ending 20px right of centre) and phone (starting 49px right of centre) on one row 36px below the title; social
     icons 32px below; the 460px form 45px below them. */
  .contact { min-height: 784px; padding: 95px 0 60px; }
  .contact-in { width: min(980px, 100% - 32px); margin-inline: auto; padding-left: 17px; }
  .contact h2 { line-height: normal; }
  .ci-row { direction: ltr; display: grid; grid-template-columns: 1fr 1fr; column-gap: 13px; margin: 35px 0 0 52px; }
  .ci { font-family: var(--font-contact); font-weight: 300; font-size: 20px; line-height: 24px; letter-spacing: 5px; color: var(--ink); }
  .ci-i { display: none; width: 28px; height: 28px; }
  .ci-email { text-align: right; }
  /* Wix: a 1px #414141 rule, 56px tall, left of the phone number (x 753) */
  .ci-phone { text-align: left; justify-self: start; border-left: 1px solid #414141; padding: 16px 0 16px 15px; margin-block: -16px; }
  .ci-social { display: flex; justify-content: center; margin-top: 32px; }
  .ci-form { width: min(460px, 100%); margin: 45px auto 0; }
  @media (pointer: coarse) { .ci { padding-block: 10px; margin-block: -10px; } }

  /* Narrower than the Wix composition: the same columns, scaled to the window. */
  @media (max-width: 1120px) {
    .split-homes .split-in, .split-business .split-in { width: calc(100% - 32px); margin-left: 16px; margin-right: auto; }
    .split-homes, .split-business { min-height: 0; padding-bottom: 40px; }
  }
  /* Wix mobile (320px design, sizes x --m). Order: slideshow, intro, values, homes (no photo), businesses, contact,
     quote, tasting gallery. */
  @media (max-width: 760px) {
    :global(#main:has(> .tasting)) { display: flex; flex-direction: column; }
    .contact { order: 1; }
    .quote { order: 2; }
    .tasting { order: 3; }

    .intro { min-height: calc(377 * var(--m)); padding: calc(30 * var(--m)) calc(24 * var(--m)) 0; }
    .mark { width: calc(80 * var(--m)); height: calc(80 * var(--m)); }
    .mark-ring::before { left: calc(-6 * var(--m)); top: calc(-10 * var(--m)); width: calc(93 * var(--m)); height: calc(100 * var(--m)); }
    .intro-links .link-caps { font-size: calc(16 * var(--m)); letter-spacing: calc(2.4 * var(--m)); }
    .intro .h-spaced { font-size: calc(23 * var(--m)); line-height: calc(32.2 * var(--m)); letter-spacing: calc(3.45 * var(--m)); margin-top: calc(19 * var(--m)); }
    .intro-text { font-size: calc(17 * var(--m)); line-height: calc(23.8 * var(--m)); margin-top: calc(11 * var(--m)); }
    .intro-links { flex-direction: column; align-items: center; gap: calc(29 * var(--m)); margin: calc(8 * var(--m)) 0 0; }
    .intro-links a:first-child { order: 2; }

    .values { display: block; position: relative; width: 100%; height: calc(840 * var(--m)); min-height: 0; padding: 0; direction: rtl; }
    .value { position: absolute; top: calc(var(--mt) * var(--m)); left: 0; right: 0; }
    .value :global(svg) { width: calc(57 * var(--m)); height: calc(56 * var(--m)); }
    .value h3 { position: static; margin-top: calc(9 * var(--m)); }

    .split-homes, .split-business { min-height: 0; padding: 0; }
    .split-homes .split-in, .split-business .split-in { display: flex; flex-direction: column; width: auto; margin: 0 calc(20 * var(--m)); direction: rtl; }
    .split-homes .split-img { display: none; }
    .split-business .split-in { padding-top: calc(48 * var(--m)); }
    .split-img { order: -1; align-self: center; width: calc(247 * var(--m)); margin: 0; }
    .split-text { padding-top: 0; }
    .split-business .split-text { padding-top: calc(59 * var(--m)); }
    .split-text .h-split { font-size: calc(19 * var(--m)); line-height: calc(26.6 * var(--m)); letter-spacing: calc(2.85 * var(--m)); }
    .split-text .body { font-size: calc(17 * var(--m)); line-height: calc(23.8 * var(--m)); margin-top: calc(12 * var(--m)); }
    .split-text .btn-dark { align-self: center; width: calc(160 * var(--m)); height: calc(42 * var(--m)); min-height: 44px; margin-top: calc(21 * var(--m)); font-size: calc(15 * var(--m)); }
    .split-business { padding-bottom: calc(220 * var(--m)); }

    .contact { min-height: 0; padding: 0 0 calc(20 * var(--m)); }
    .contact-in { width: auto; padding: 0; display: flex; flex-direction: column; align-items: center; }
    .contact h2 { font-size: calc(24 * var(--m)); letter-spacing: calc(3.6 * var(--m)); }
    .ci-row { display: flex; direction: ltr; gap: calc(35 * var(--m)); margin: calc(23 * var(--m)) 0 0; }
    /* Wix mobile: envelope and phone icons with a 1px rule between them */
    .ci-row { gap: 0; align-items: center; }
    .ci, .ci-phone { letter-spacing: 0; margin: 0; display: flex; align-items: center; min-height: 44px; }
    .ci-email { padding: calc(4 * var(--m)) calc(17 * var(--m)) calc(4 * var(--m)) 8px; }
    .ci-phone { padding: calc(4 * var(--m)) 8px calc(4 * var(--m)) calc(17 * var(--m)); border-left: 1px solid #414141; }
    .ci-t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .ci-i { display: block; width: calc(28 * var(--m)); height: calc(28 * var(--m)); }
    .ci-form { order: 1; width: calc(260 * var(--m)); margin-top: calc(73 * var(--m)); }
    .ci-social { order: 2; margin-top: calc(64 * var(--m)); }
    .ci-social :global(.social) { flex-direction: row-reverse; } /* Wix mobile: Instagram first */
    .ci-social :global(svg) { width: calc(24 * var(--m)); height: calc(24 * var(--m)); }
    .ci-social :global(.social a) { color: #8a8a8a; }

    .quote { height: calc(200 * var(--m)); }
    .quote-in { padding: 0 calc(33 * var(--m)); }
    .q { font-size: calc(25 * var(--m)); line-height: calc(35 * var(--m)); }
    .by { font-size: calc(21 * var(--m)); line-height: calc(29.4 * var(--m)); margin-top: calc(9 * var(--m)); }

    .tasting { min-height: calc(247 * var(--m)); padding: 0 0 calc(30 * var(--m)); }
    .tasting h2 { font-size: calc(21 * var(--m)); letter-spacing: calc(3.15 * var(--m)); }
    .t-view { width: calc(280 * var(--m)); margin-top: calc(19 * var(--m)); }
    .t-track { gap: calc(10 * var(--m)); }
    .t-track img { width: calc(82 * var(--m)); height: calc(109 * var(--m)); }
    .t-next { top: calc(35 * var(--m)); right: calc(23 * var(--m)); }
  }
</style>

<script>
  // Tasting strip: one photo to the left every 4 seconds (as on Wix), endless; pauses while hovered or focused and
  // when the visitor prefers reduced motion. The arrow moves it by one photo.
  document.querySelectorAll<HTMLElement>('.tasting .t-view').forEach((view) => {
    const track = view.querySelector<HTMLElement>('.t-track')!;
    const count = track.children.length / 2;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, paused = false;
    const step = () => (track.children[1] as HTMLElement).offsetLeft - (track.children[0] as HTMLElement).offsetLeft;
    const go = () => {
      i += 1;
      track.classList.add('moving');
      track.style.transform = `translateX(${-i * step()}px)`;
    };
    track.addEventListener('transitionend', () => {
      if (i < count) return;
      i = 0;
      track.classList.remove('moving');
      track.style.transform = 'translateX(0)';
    });
    view.querySelector('.t-next')!.addEventListener('click', go);
    view.addEventListener('mouseenter', () => { paused = true; });
    view.addEventListener('mouseleave', () => { paused = false; });
    view.addEventListener('focusin', () => { paused = true; });
    view.addEventListener('focusout', () => { paused = false; });
    if (!reduce) setInterval(() => { if (!paused && !document.hidden) go(); }, 4000);
  });
</script>
