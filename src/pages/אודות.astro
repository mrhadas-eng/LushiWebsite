---
import Base from '../layouts/Base.astro';
import { about, site } from '../data/content.mjs';
import { img } from '../lib/media.mjs';
const [a, b] = about.images.map((i) => ({ ...img(i.id, 960), alt: i.alt }));
const mark = img(site.mark);
const portrait = img(about.portrait.id);
---
<Base title={about.title} ogImage={about.images[1].id}>
  <section class="about">
    <img class="a-img a-1" src={a.src} srcset={a.srcset} sizes="(max-width: 760px) 100vw, 28vw" alt={a.alt} width="404" height="724" />
    <div class="a-text reveal">
      <img class="mark" src={mark.src} alt="Lushi-Logo-01.png" width="64" height="64" />
      <h1 class="a-title">{about.title}</h1>
      <h2 class="a-sub">{about.subtitle}</h2>
      <img class="a-portrait" src={portrait.src} alt={about.portrait.alt} width="225" height="206" loading="lazy" />
      <p class="a-body pre">{about.text}</p>
    </div>
    <img class="a-img a-2" src={b.src} srcset={b.srcset} sizes="(max-width: 760px) 100vw, 28vw" alt={b.alt} width="403" height="724" />
  </section>
</Base>

<style>
  /* Wix (1440px): a full-width band, 724px tall, directly under the header. The two photos fill its left and right
     edges (404 and 403px of 1440, i.e. 28% of the window each); the centre column holds the 64px logo mark, the title
     in Heebo ExtraLight 75px, the subtitle (Futura 16px, 1.6px spacing, #636363) and the text in Heebo Regular
     16/24px, all centred. Laid out left to right as on Wix: the first photo is on the left. */
  .about { direction: ltr; display: grid; grid-template-columns: 28.056% 1fr 27.986%; height: 724px; }
  .a-img { width: 100%; height: 100%; object-fit: cover; }
  .a-text { background: #f9f9f9; direction: rtl; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 34px 16px 0; }
  .mark { width: 64px; height: 64px; }
  .a-title { font-family: var(--font-heebo); font-weight: 200; font-size: 75px; line-height: 37.5px; margin-top: 6px; }
  .a-sub { font-family: var(--font-futura); font-weight: 400; font-size: 16px; line-height: 19.2px; letter-spacing: 1.6px; color: var(--muted); max-width: 380px; margin-top: 19.5px; }
  .a-body { font-family: var(--font-heebo); font-weight: 400; font-size: 16px; line-height: 24px; max-width: 490px; margin-top: 38px; }

  .a-portrait { display: none; }

  /* Wix mobile (x --m): one #f9f9f9 column: the 60px mark 24px below the header, the title (Heebo ExtraLight 33px
     on 16.5px lines), the subtitle (16/19.2px), the round portrait (225x206), the text (Heebo 14/21px, 280px wide),
     then the first photo full width (320x200); the second photo is not shown. */
  @media (max-width: 760px) {
    .about { display: flex; flex-direction: column; height: auto; direction: rtl; background: #f9f9f9; }
    .a-text { padding: calc(24 * var(--m)) calc(20 * var(--m)) 0; }
    .mark { width: calc(60 * var(--m)); height: calc(60 * var(--m)); }
    .a-title { font-size: calc(33 * var(--m)); line-height: calc(16.5 * var(--m)); margin-top: calc(-5 * var(--m)); padding-block: calc(16 * var(--m)); }
    .a-sub { font-size: calc(16 * var(--m)); line-height: calc(19.2 * var(--m)); letter-spacing: calc(1.6 * var(--m)); margin-top: calc(9 * var(--m)); max-width: calc(256 * var(--m)); }
    .a-portrait { display: block; width: calc(225 * var(--m)); height: auto; margin-top: calc(12 * var(--m)); }
    .a-body { font-size: calc(14 * var(--m)); line-height: calc(21 * var(--m)); margin-top: calc(12 * var(--m)); max-width: none; }
    .a-1 { order: 2; height: calc(200 * var(--m)); margin-top: calc(24 * var(--m)); }
    .a-2 { display: none; }
  }
</style>
