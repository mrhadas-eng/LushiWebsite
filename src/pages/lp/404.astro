    <h1 style="font-weight:500;font-size:40px;line-height:48px;margin:8px 0 16px">העמוד לא נמצא</h1>
    <p style="font-size:17px;line-height:25.5px;margin:0 0 14.4px"><a href={lpHref('/')}>לדף הבית</a></p>
  </section>
</LpBase>
