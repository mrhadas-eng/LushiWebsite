---
// lp.hagarlushi.com/thankyou/  (WordPress page 244). Kept at the same URL: the existing Google Ads
// conversion in GTM fires on this page view. generate_lead is pushed only after a confirmed lead.
import LpBase from '../../layouts/LpBase.astro';
import { lpThankYou, lpWhatsAppUrl } from '../../data/lp.mjs';
const waUrl = lpWhatsAppUrl();
---
<LpBase title={lpThankYou.title} path={lpThankYou.path}>
  <section class="lp-ty">
    <div class="lp-ty-card">
      <span class="lp-ty-badge"><svg class="lp-ty-icon" viewBox="0 0 50 50" width="50" height="50" aria-hidden="true"><path d="M3 21l22-16 22 16v25H3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 21l22 15 22-15M3 46l17-13M47 46L30 33" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M11 13h28v14" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M19 19l4 4 8-8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span>
      <h1>{lpThankYou.heading}</h1>
      <p>{lpThankYou.text}</p>
      <a class="lp-ty-wa" href={waUrl} target="_blank" rel="noopener" data-track="lp_thankyou"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>{lpThankYou.whatsappButton}</a>
    </div>
  </section>
</LpBase>
<script>
  import { recordLeadConversion } from '../../lib/lead-client.js';
  window.dataLayer = window.dataLayer || [];
  recordLeadConversion(sessionStorage, window.dataLayer);
</script>
<style>
  /* Redesigned (owner, 2026-11-01): WordPress had no layout container here, so the content sat flush against the
     right edge of the window. Now a centred card on the soft page background, filling the space between header and
     footer; the WhatsApp button uses the landing pages' dark button style. Texts, URL and tracking are unchanged. */
  .lp-ty { display: grid; place-items: center; min-height: calc(100vh - 140px - 195px); min-height: calc(100svh - 140px - 195px);
    padding: 64px 20px; background: var(--lp-soft); color: var(--lp-ink); text-align: center; }
  .lp-ty-card { width: 100%; max-width: 560px; display: grid; justify-items: center; gap: 0; background: #fff;
    padding: 48px 40px 44px; border-radius: 12px; box-shadow: 0 10px 40px rgba(0, 0, 0, .06); }
  .lp-ty-badge { display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%;
    background: rgba(63, 100, 75, .1); color: var(--lp-green); margin-bottom: 24px; }
  .lp-ty-badge svg { width: 44px; height: 44px; }
  .lp-ty h1 { margin: 0 0 12px; font-family: 'Noto Sans Hebrew', var(--lp-font); font-size: 36px; line-height: 1.2; font-weight: 600; color: var(--lp-ink); }
  .lp-ty p { margin: 0 0 32px; font-size: 18px; line-height: 1.6; color: var(--lp-text); }
  .lp-ty-wa { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 28px; border-radius: 36px;
    background: var(--lp-ink); color: #fff !important; text-decoration: none; font-family: 'Noto Sans Hebrew', var(--lp-font);
    font-size: 17px; font-weight: 600; }
  .lp-ty-wa:hover { background: #333; }
  .lp-ty-wa svg { flex: none; }
  @media (max-width: 767px) {
    .lp-ty { min-height: calc(100svh - 100px - 199px); padding: 32px 16px; }
    .lp-ty-card { padding: 36px 22px 32px; }
    .lp-ty-badge { width: 72px; height: 72px; margin-bottom: 20px; } .lp-ty-badge svg { width: 38px; height: 38px; }
    .lp-ty h1 { font-size: 28px; }
    .lp-ty p { font-size: 17px; margin-bottom: 28px; }
    .lp-ty-wa { width: 100%; justify-content: center; }
  }
</style>
