---
// lp.hagarlushi.com/privacy/  (WordPress page 378) – text exported unchanged; pending the owner's review (D5).
import LpBase from '../../layouts/LpBase.astro';
import { lpLegal } from '../../data/lp.mjs';
import { legalHtml } from '../../lib/lp-legal.mjs';
const page = lpLegal.find((p) => p.path === '/privacy/')!;
const html = legalHtml(page.wpId);
---
<LpBase title={page.title} path={page.path}>
  <article class="lp-legal">{html ? <Fragment set:html={html} /> : <p>התוכן לא נמצא (src/data/lp/wp-pages.json).</p>}</article>
</LpBase>
