---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Social from '../components/Social.astro';
import { contact, site } from '../data/content.mjs';
import { img } from '../lib/media.mjs';
const photo = img(contact.image, 960);
const mark = img(site.mark);
---
<Base title={contact.title}>
  <section class="contact-page">
    <div class="cp-grid">
      <div class="cp-col">
        <div class="cp-text reveal">
          <h1 class="cp-title">{contact.title}</h1>
          <p class="cp-sub">{contact.subtitle}</p>
          <a class="cp-mail" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="cp-phone" href={site.phoneHref} dir="ltr">{site.phone}</a>
          <Social size={29} gap={12} order="ig-fb" class="cp-social" />
        </div>
        <ContactForm variant="page" />
      </div>
      <div class="cp-markcol"><img class="mark" src={mark.src} alt="Lushi-Logo-01.png" width="80" height="80" /></div>
      <img class="cp-img reveal" src={photo.src} srcset={photo.srcset} sizes="(max-width: 760px) 88vw, 534px" alt="lushishirly_ph_NetaCones (37).jpg" width="534" height="800" />
    </div>
  </section>
</Base>

<style>
  /* Desktop, measured on Wix at 1440px (980px page at x 230): the text and the form are on the LEFT (x 278-634), a
     vertical rule at x 630 next to the text, the logo mark at x 625, the 534x800 image on the RIGHT (x 722-1256,
     46px past the page edge). Columns 48 | 356 | 88 | 534, laid out left to right as on Wix; below 1060px they
     shrink proportionally (the tablet target is the desktop composition fitted to the width). */
  .contact-page { padding: 49px 0 157px; }
  .cp-grid {
    direction: ltr; display: grid; grid-template-columns: 48fr 356fr 88fr 534fr; align-items: start;
    width: min(1026px, 100% - max(16px, 50% - 490px) - 16px); margin-left: max(16px, 50% - 490px); margin-right: auto;
  }
  .cp-col { grid-column: 2; direction: rtl; }
  .cp-markcol { grid-column: 3; position: relative; }
  .cp-img { grid-column: 4; width: 100%; aspect-ratio: 534 / 800; object-fit: cover; }

  .cp-text { position: relative; display: flex; flex-direction: column; align-items: flex-start; padding-right: 21px; padding-top: 1px; }
  .cp-text::after { content: ''; position: absolute; right: 3px; top: 0; height: 267px; border-right: 1px solid #282626; }
  .cp-title { font-size: 50px; line-height: 50px; padding-bottom: 25px; border-bottom: 1px solid #424242; min-width: 193px; }
  .cp-sub { font-size: 20px; line-height: 28px; max-width: 192px; margin-top: 13px; }
  .cp-mail, .cp-phone {
    font-family: var(--font-condensed); font-stretch: 75%; font-weight: 400; font-size: 20px; line-height: 24px;
    letter-spacing: 4px; margin-right: 3px;
  }
  .cp-mail { margin-top: 19px; }
  .cp-phone { margin-top: 14px; }
  .cp-text :global(.cp-social) { margin-top: 14px; margin-right: 3px; }
  .cp-col :global(.contact-form) { margin-top: 66px; }
  .mark { position: absolute; left: -9px; top: 107px; width: 80px; height: 80px; max-width: none; }
  @media (pointer: coarse) { .cp-phone, .cp-mail { padding-block: 10px; margin-block: -10px; } .cp-mail { margin-top: 9px; } .cp-phone { margin-top: 4px; } }

  /* Mobile: the Wix mobile page is designed 320px wide and scaled to the phone, so every size here is
     (Wix value) x var(--m) with --m = 100vw / 320. Centred column: mark, title with a rule under it, text,
     email, phone, icons, the form (260 wide), then the image (280x419). */
  @media (max-width: 760px) {
    .contact-page { --m: calc(100vw / 320); padding: calc(12 * var(--m)) 0 calc(37 * var(--m)); }
    .cp-grid { display: flex; flex-direction: column; align-items: center; width: auto; margin: 0; direction: rtl; }
    .cp-col { display: contents; }
    .cp-markcol { order: -1; }
    .mark { position: static; width: calc(60 * var(--m)); height: calc(60 * var(--m)); }
    .cp-text { align-items: center; text-align: center; padding: 0; width: calc(272 * var(--m)); }
    .cp-text::after { display: none; }
    .cp-title { font-size: calc(30 * var(--m)); line-height: calc(30 * var(--m)); width: 100%; padding: calc(4 * var(--m)) 0 calc(10 * var(--m)); }
    .cp-sub { font-size: calc(19 * var(--m)); line-height: calc(26.6 * var(--m)); max-width: none; margin-top: calc(13 * var(--m)); }
    .cp-mail, .cp-phone { font-size: calc(20 * var(--m)); line-height: calc(24 * var(--m)); letter-spacing: calc(4 * var(--m)); margin-right: 0; }
    .cp-mail { margin-top: calc(26 * var(--m)); }
    .cp-phone { margin-top: calc(17 * var(--m)); }
    .cp-text :global(.cp-social) { margin: calc(23 * var(--m)) 0 0; }
    .cp-text :global(.cp-social) { gap: calc(15 * var(--m)); }
    .cp-text :global(.cp-social svg) { width: calc(35 * var(--m)); height: calc(35 * var(--m)); }
    .cp-col :global(.contact-form) { width: calc(260 * var(--m)); margin-top: calc(44 * var(--m)); }
    /* Form on phones: labelled 44px fields (ContactForm.astro), 18px apart, the button centred */
    .cp-col :global(.cf-page .f-email), .cp-col :global(.cf-page .f-phone), .cp-col :global(.cf-page .f-msg) { margin-top: 18px; }
    .cp-col :global(.cf-page .send) { justify-self: center; margin-top: 22px; width: calc(120 * var(--m)); height: 48px; font-size: max(16px, calc(16 * var(--m))); }
    .cp-img { width: calc(280 * var(--m)); height: auto; margin-top: calc(75.5 * var(--m)); }
  }
</style>
