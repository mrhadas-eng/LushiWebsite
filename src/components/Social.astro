---
import { site } from '../data/content.mjs';
interface Props { size?: number; class?: string }
const { size = 22, class: cls } = Astro.props;
---
<ul class:list={['social', cls]}>
  <li>
    <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram">
      <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/></svg>
    </a>
  </li>
  <li>
    <a href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook">
      <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg>
    </a>
  </li>
</ul>
<style>
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: 14px; align-items: center; }
  .social a { display: inline-flex; color: var(--ink); opacity: .9; transition: opacity .2s; }
  .social a:hover { opacity: .6; }
</style>
