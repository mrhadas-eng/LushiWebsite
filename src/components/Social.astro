---
import { site } from '../data/content.mjs';
// `order` is the visual order from left to right, as on Wix: the top bar and the contact sections show
// Instagram then Facebook; the footer shows Facebook then Instagram.
interface Props { size?: number; gap?: number; order?: 'ig-fb' | 'fb-ig'; class?: string }
const { size = 22, gap = 14, order = 'ig-fb', class: cls } = Astro.props;
const links = [
  { key: 'ig', href: site.instagram, label: 'Instagram' },
  { key: 'fb', href: site.facebook, label: 'Facebook' },
];
if (order === 'fb-ig') links.reverse();
---
<ul class:list={['social', cls]} style={`--gap:${gap}px`}>
  {links.map((l) => (
    <li>
      <a href={l.href} target="_blank" rel="noopener" aria-label={l.label}>
        {l.key === 'ig'
          ? <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/></svg>
          : <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg>}
      </a>
    </li>
  ))}
</ul>
<style>
  /* direction: ltr so the icons appear left-to-right in the order above, as on Wix (the page itself is RTL) */
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--gap); align-items: center; direction: ltr; }
  .social li { display: flex; }
  .social a { display: inline-flex; color: var(--ink); opacity: .9; transition: opacity .2s; }
  .social a:hover { opacity: .6; }
  /* Touch screens: 44px tap area around each icon (the icon itself stays the same size). */
  @media (pointer: coarse) {
    .social { gap: max(var(--gap), 26px); }
    .social a { padding: 13px; margin: -13px; }
  }
</style>
