---
import { nav, site } from '../data/content.mjs';
import { img } from '../lib/media.mjs';
import Social from './Social.astro';

const path = decodeURI(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (item) =>
  item.href === path || (item.children ?? []).some((c) => c.href === path);
const logo = img(site.logo);
const mark = img(site.mark);
---
<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar-in">
      <a class="phone" href={site.phoneHref} aria-label={`טלפון ${site.phone}`}>
        <span>{site.phone}</span>
        <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1" d="M6.6 3.5h3l1.5 4-2 1.3a11 11 0 0 0 5.9 5.9l1.3-2 4 1.5v3c0 .8-.7 1.5-1.5 1.5A16.6 16.6 0 0 1 5 5c0-.8.7-1.5 1.6-1.5z"/></svg>
      </a>
      <Social size={29} gap={12} order="ig-fb" />
    </div>
  </div>

  <div class="brand">
    <a href="/" aria-label="הגר לושי - דף הבית">
      <img src={logo.src} alt="business logo" width="344" height="120" />
    </a>
  </div>

  <nav class="menu" aria-label="תפריט ראשי">
    <button class="menu-toggle" aria-expanded="false" aria-controls="menu-list">
      <span class="visually-hidden">תפריט</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
    <ul id="menu-list" class="menu-list">
      <li class="menu-mark" aria-hidden="true"><img src={mark.src} alt="" width="51" height="51" /></li>
      {nav.map((item) => (
        <li class:list={['menu-item', { 'has-sub': item.children, active: isActive(item) }]}>
          <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
          {item.children && (
            <>
              <button class="sub-toggle" aria-expanded="false" aria-label={`פתיחת ${item.label}`}>
                <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" /></svg>
              </button>
              <ul class="sub">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={c.href === path ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            </>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* Wix: the 249px header casts a soft shadow (0 0 5px rgba(0,0,0,.7)) onto the page below */
  .site-header { background: #fff; position: relative; z-index: 20; box-shadow: 0 0 5px rgba(0, 0, 0, .7); }
  .topbar { background: var(--dark); color: #fff; height: 45px; }
  /* Wix: icons 19px from the left of the 980px page, phone group 25px from its right */
  .topbar-in { height: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 25px 0 19px; }
  .phone {
    display: inline-flex; align-items: center; gap: 7px; min-height: 44px;
    font-family: var(--font-contact); font-weight: 300; font-size: 15px; letter-spacing: 3.75px;
    direction: ltr;
  }
  .topbar :global(.social a) { color: #fff; }

  .brand { display: flex; justify-content: center; padding: 15px 0 12px; }
  /* The logo file is a 1200x1200 square with wide transparent margins.
     Wix shows it cropped to a centered 344x120 strip; object-fit reproduces that. */
  .brand img { width: 344px; height: auto; aspect-ratio: 344 / 120; object-fit: cover; object-position: center; }

  .menu { position: relative; }
  /* Matches the Wix menu: equal 131px cells (Wix had six; the press page was removed), each with a thin dark line on top;
     the current page gets a thicker, softer 4px line. */
  .menu-list {
    list-style: none; margin: 0; padding: 0 0 7px;
    display: flex; justify-content: center; flex-wrap: nowrap; gap: 0;
  }
  /* 130px cells as on Wix; they shrink (instead of wrapping onto a second row) when they
     don't fit, i.e. on tablets between the 760px mobile breakpoint and 780px. */
  .menu-item { position: relative; display: flex; align-items: center; flex: 0 1 131px; min-width: 0; }
  .menu-item > a {
    flex: 1; margin: 0 5px; text-align: center;
    font-size: 18px; line-height: 49px; color: #636363;
    border-top: 1px solid #414141; transition: color .2s;
  }
  .menu-item > a:hover, .menu-item.active > a { color: var(--ink); }
  .menu-item.active > a { border-top: 4px solid rgba(0, 0, 0, .49); line-height: 46px; }
  /* Wix desktop: a 24px dropdown button straddling the cell's left edge, with a 10px chevron */
  .sub-toggle { position: absolute; z-index: 1; left: -23px; top: 0; width: 24px; height: 24px; display: grid; place-items: center; background: none; border: 0; padding: 0; cursor: pointer; color: var(--muted); }
  /* Touch screens with the desktop menu (tablets): a 44px invisible tap area around the 24px arrow. */
  @media (pointer: coarse) and (min-width: 761px) { .sub-toggle::after { content: ''; position: absolute; inset: -10px; } }

  .sub {
    list-style: none; margin: 0; padding: 8px 0;
    position: absolute; top: 100%; inset-inline-start: 50%; transform: translateX(50%);
    min-width: 210px; background: #fff; box-shadow: 0 6px 24px rgba(0,0,0,.08);
    opacity: 0; visibility: hidden; transition: opacity .2s, visibility .2s;
  }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; }
  .sub a { display: block; padding: 7px 20px; font-size: 16px; color: var(--muted); white-space: nowrap; }
  .sub a:hover, .sub a[aria-current='page'] { color: var(--ink); background: var(--soft); }

  .menu-toggle { display: none; }

  .menu-mark { display: none; }

  /* Wix mobile (320px design, sizes x --m): a white 229px header; Instagram and Facebook (24px, grey) at the top
     left, the menu button pinned at the top right, the logo (240x84) centred 63px down and a black 280x8 bar under
     it. The menu opens as a white 260px panel from the right over a grey veil: the logo mark in a circle, then the
     pages centred (16px, 45px lines, the current page grey), with the sub-menu arrows on their left. */
  @media (max-width: 760px) {
    .site-header { box-shadow: none; height: calc(229 * var(--m)); }
    .topbar { background: none; height: auto; }
    .topbar-in { position: absolute; top: calc(15 * var(--m)); left: calc(15 * var(--m)); padding: 0; width: auto; height: auto; }
    .phone { display: none; }
    .topbar :global(.social) { --gap: calc(12 * var(--m)) !important; }
    .topbar :global(.social a) { color: #8a8a8a; }
    .topbar :global(.social svg) { width: calc(24 * var(--m)); height: calc(24 * var(--m)); }
    .brand { flex-direction: column; align-items: center; padding: calc(63 * var(--m)) 0 0; }
    .brand img { width: calc(240 * var(--m)); }
    .brand::after { content: ''; display: block; width: calc(280 * var(--m)); height: calc(8 * var(--m)); margin-top: calc(10 * var(--m)); background: #000; }
    .menu-toggle {
      display: grid; place-items: center; position: fixed; z-index: 40; top: calc(6 * var(--m)); right: calc(13 * var(--m));
      width: max(44px, calc(41 * var(--m))); height: max(44px, calc(40 * var(--m))); background: none; border: 0; cursor: pointer; padding: 0;
    }
    .bars, .bars::before, .bars::after { display: block; width: calc(21 * var(--m)); height: 2px; background: #000; position: relative; content: ''; transition: transform .2s, background .2s; }
    .bars::before { position: absolute; top: calc(-7 * var(--m)); }
    .bars::after { position: absolute; top: calc(7 * var(--m)); }
    .menu.open .bars { background: transparent; }
    .menu.open .bars::before { transform: translateY(calc(7 * var(--m))) rotate(45deg); }
    .menu.open .bars::after { transform: translateY(calc(-7 * var(--m))) rotate(-45deg); }
    .menu.open::before { content: ''; position: fixed; inset: 0; z-index: 30; background: rgba(65, 65, 65, .6); }
    .menu-list {
      display: none; position: fixed; z-index: 35; top: 0; right: 0; bottom: 0; width: calc(260 * var(--m)); overflow-y: auto;
      flex-direction: column; align-items: center; justify-content: flex-start; gap: 0; padding: calc(54 * var(--m)) 0 calc(30 * var(--m)); background: #fff;
    }
    .menu.open .menu-list { display: flex; }
    .menu-mark { display: grid; place-items: center; width: calc(64 * var(--m)); height: calc(64 * var(--m)); border: 1px solid #414141; border-radius: 50%; margin-bottom: calc(34 * var(--m)); }
    .menu-mark img { width: calc(51 * var(--m)); height: calc(51 * var(--m)); }
    .menu-item { flex: none; width: calc(188 * var(--m)); display: block; text-align: center; }
    .menu-item > a, .menu-item.active > a { display: block; margin: 0; border: 0; padding: 0; font-size: calc(16 * var(--m)); line-height: max(44px, calc(45 * var(--m))); color: var(--ink); }
    .menu-item.active > a { color: #999; }
    .sub-toggle { position: absolute; left: 0; top: 0; width: calc(50 * var(--m)); height: max(44px, calc(45 * var(--m))); color: #000; }
    .sub-toggle svg { width: calc(13 * var(--m)); height: calc(8 * var(--m)); }
    .sub { position: static; transform: none; box-shadow: none; opacity: 1; visibility: visible; display: none; min-width: 0; padding: 0 0 calc(8 * var(--m)); }
    .has-sub:hover .sub { display: none; }
    .has-sub.open .sub { display: block; }
    .sub a { padding: 0; font-size: calc(15 * var(--m)); line-height: max(40px, calc(36 * var(--m))); white-space: normal; }
  }
</style>

<script>
  const menu = document.querySelector('.menu');
  const toggle = document.querySelector('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = menu.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  // Mobile panel: Escape or a tap on the grey veil closes it
  const close = () => { if (menu?.classList.contains('open')) { menu.classList.remove('open'); toggle?.setAttribute('aria-expanded', 'false'); toggle?.focus(); } };
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  menu?.addEventListener('click', (e) => { if (e.target === menu) close(); });
  document.querySelectorAll('.sub-toggle').forEach((b) => b.addEventListener('click', () => {
    const li = b.closest('.has-sub');
    const open = li.classList.toggle('open');
    b.setAttribute('aria-expanded', String(open));
  }));
</script>
