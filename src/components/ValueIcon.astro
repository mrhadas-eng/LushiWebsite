---
// Line icons for the five value statements on the home page. Wix shows geometric line figures from the Wix vector-art
// library (licensed for Wix sites only, see docs/VISUAL-PARITY-AUDIT.md), so these are our own drawings of simple
// geometric figures at the same sizes as on Wix (75px wide; the diamond grid 82px) in #414141.
interface Props { name: string }
const { name } = Astro.props;
const size: Record<string, [number, number]> = { pencil: [75, 51], blend: [75, 68], scale: [82, 57], cube: [75, 55], hands: [75, 41] };
const [w, h] = size[name] ?? [75, 60];
---
<svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} aria-hidden="true" fill="none" stroke="#414141" stroke-width="1" stroke-linejoin="round">
  {name === 'pencil' && (<>
    {/* three overlapping peaks */}
    <path d="M1 50h73L58 23 49 38 37.5 2 26 38 17 23z" /><path d="M17 23l12 21H46l12-21" /><path d="M29 44l8.5-14L46 44" />
  </>)}
  {name === 'blend' && (<>
    {/* a triangle divided into a triangular grid */}
    <path d="M37.5 1L74 67H1z" /><path d="M19.25 34h36.5M10.1 50.5h54.8M28.4 17.5h18.2" />
    <path d="M28.4 17.5L55.8 67M19.25 34L37.5 67M10.1 50.5L19.25 67M46.6 17.5L19.25 67M55.75 34L37.5 67M64.9 50.5L55.75 67" />
  </>)}
  {name === 'scale' && (<>
    {/* a diamond divided into a grid */}
    <path d="M1 28.5L28.5 1h25L81 28.5 53.5 56h-25z" /><path d="M1 28.5h80" />
    <path d="M28.5 1L41 13.5 53.5 1M28.5 56L41 43.5 53.5 56M14.75 14.75L41 41 67.25 14.75M14.75 42.25L41 16 67.25 42.25" />
  </>)}
  {name === 'cube' && (<>
    {/* two triangles side by side */}
    <path d="M1 54L22 18l8 14L50 1l24 53z" /><path d="M30 32l-13 22M22 54L30 40l8 14" />
  </>)}
  {name === 'hands' && (<>
    {/* a chain of three diamonds */}
    <path d="M1 20.5L18 1.5l19.5 19-19.5 19z" /><path d="M18 1.5L37.5 20.5 57 1.5 74 20.5 57 39.5 37.5 20.5 18 39.5" />
    <path d="M27.75 11l9.75 9.5 9.75-9.5M27.75 30l9.75-9.5 9.75 9.5" />
  </>)}
</svg>
