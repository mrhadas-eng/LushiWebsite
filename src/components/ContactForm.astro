---
// Contact form (home page + contact page). Each lead is POSTed as JSON to the site's own
// endpoint /api/lead (worker/index.js), which translates it and forwards it to OfficeCRM. Only when
// the Worker answers { ok: true } (OfficeCRM replied success: true) is the visitor sent to /thankyou,
// where the lead is counted for analytics (generate_lead).
//
// Validation (src/lib/lead-rules.js, the same rules the Worker applies): each missing or invalid
// required field gets its own Hebrew message next to it, the first one is focused and nothing is sent.
// The separate delivery-failure message (with this site's phone / WhatsApp) is shown only when a valid
// lead could not be delivered; what the visitor typed is always kept.
//
// Under `npm run dev` there is no Worker, so sending fails by design; use `npm run preview:cf`.
//
// Website payload sent to /api/lead (empty values omitted). The Worker turns it into OfficeCRM's website-v1 request
// (docs/OFFICECRM-INTEGRATION-CONTRACT.md): full_name, email, phone, message, form ("home" | "contact"),
//   page_path, landing_page, referrer, utm_source, utm_medium, utm_campaign, utm_term, utm_content, gclid, fbclid,
//   plus submission_id and submitted_at, added by submitLead() (one ID per enquiry, reused on resends).
import { site } from '../data/content.mjs';
import { DELIVERY_FAILED_TEXT, DELIVERY_UNCERTAIN_TEXT } from '../lib/lead-rules.js';
interface Props { variant?: 'home' | 'page' }
const { variant = 'home' } = Astro.props;
const f = variant === 'home'
  ? { name: 'שם מלא', email: 'אימייל', phone: 'טלפון', msg: 'במה אוכל לעזור?' }
  // OfficeCRM requires name, phone and email, so both forms require all three.
  : { name: 'שם', email: 'דוא"ל', phone: 'טלפון', msg: 'הודעה' };
const waHref = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.message)}`;
const uid = variant === 'home' ? 'home' : 'contact';
const id = (field: string) => `${uid}-${field}-err`;
const [failBefore, failAfter] = DELIVERY_FAILED_TEXT.split('בטלפון או בוואטסאפ');
const [unsureBefore, unsureAfter] = DELIVERY_UNCERTAIN_TEXT.split('בטלפון או בוואטסאפ');
const REQ = ' *';
---
<form class="contact-form" novalidate
  data-endpoint={site.leadEndpoint} data-thanks={site.thankYouPath}
  data-location={variant === 'home' ? 'home' : 'contact'}>
  <!-- Spam trap: hidden from people, bots fill it in -->
  <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="field-wrap" data-field>
    <label class="field">
      <span class="visually-hidden">{f.name} (שדה חובה)</span>
      <input type="text" name="full_name" placeholder={f.name + REQ} autocomplete="name" required aria-required="true" aria-describedby={id('full_name')} />
    </label>
    <p class="field-error" id={id('full_name')} data-error-for="full_name" hidden></p>
  </div>
  <div class="field-wrap" data-field>
    <label class="field">
      <span class="visually-hidden">{f.email} (שדה חובה)</span>
      <input type="email" name="email" placeholder={f.email + REQ} autocomplete="email" required aria-required="true" aria-describedby={id('email')} />
    </label>
    <p class="field-error" id={id('email')} data-error-for="email" hidden></p>
  </div>
  <div class="field-wrap" data-field>
    <label class="field">
      <span class="visually-hidden">{f.phone} (שדה חובה)</span>
      <input type="tel" name="phone" placeholder={f.phone + REQ} autocomplete="tel" inputmode="tel" required aria-required="true" aria-describedby={id('phone')} />
    </label>
    <p class="field-error" id={id('phone')} data-error-for="phone" hidden></p>
  </div>
  <label class="field">
    <span class="visually-hidden">{f.msg}</span>
    <textarea name="message" rows="4" placeholder={f.msg}></textarea>
  </label>

  <button type="submit" class="send">שליחה</button>
  <p class="status" role="alert" hidden>
    {failBefore}<a href={site.phoneHref}>בטלפון</a> או <a href={waHref} target="_blank" rel="noopener" data-track="form_error">בוואטסאפ</a>{failAfter}
  </p>
  <p class="status status-uncertain" role="alert" hidden>
    {unsureBefore}<a href={site.phoneHref}>בטלפון</a> או <a href={waHref} target="_blank" rel="noopener" data-track="form_uncertain">בוואטסאפ</a>{unsureAfter}
  </p>
</form>

<style>
  .contact-form { display: grid; gap: 14px; width: 100%; }
  .field input, .field textarea {
    width: 100%; border: 0; border-bottom: 1px solid var(--muted); background: transparent;
    padding: 10px 2px; font-size: 16px; font-weight: 300; color: var(--ink); border-radius: 0;
  }
  .field textarea { resize: vertical; border: 1px solid var(--muted); padding: 10px; margin-top: 6px; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--ink); }
  .field [aria-invalid="true"] { border-color: #b3261e; border-bottom-width: 2px; }
  .field input[aria-invalid="true"]:focus { border-color: #b3261e; }
  .field-error { margin: 4px 2px 0; color: #b3261e; font-size: 14px; font-weight: 400; }
  .field-error::before { content: '⚠ '; }
  .send {
    justify-self: start; background: var(--dark); color: #fff; border: 0; cursor: pointer;
    font-size: 20px; line-height: 28px; padding: 8px 48px; transition: background .2s;
  }
  .send:hover { background: #4a4848; }
  .send[disabled] { opacity: .6; cursor: wait; }
  .status { font-size: 15px; color: #b3261e; }
  .status a { text-decoration: underline; }
</style>

<script>
  import { sendLead, submitLead } from '../lib/lead-client.js';
  import { validateForm, showServerFieldError, liveRevalidate } from '../lib/form-ui.js';

  const ATTR_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid', 'referrer', 'landing_page'];

  function attribution() {
    try { return JSON.parse(sessionStorage.getItem('hl_attribution') || '{}'); } catch { return {}; }
  }

  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    liveRevalidate(form);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.status:not(.status-uncertain)')!;
      const unsure = form.querySelector<HTMLElement>('.status-uncertain')!;
      const btn = form.querySelector<HTMLButtonElement>('.send')!;
      if (btn.disabled) return;                       // a request is already in progress
      status.hidden = true;
      unsure.hidden = true;
      if (!validateForm(form)) return;                // nothing sent, nothing counted

      const fd = new FormData(form);

      const a = attribution();
      const lead: Record<string, string> = {
        full_name: String(fd.get('full_name') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        phone: String(fd.get('phone') || '').trim(),
        message: String(fd.get('message') || '').trim(),
        form: form.dataset.location || '',
        page_path: location.pathname,
      };
      for (const k of ATTR_KEYS) if (a[k]) lead[k] = k === 'landing_page' ? decodeURI(a[k]) : a[k];
      for (const k of Object.keys(lead)) if (!lead[k]) delete lead[k];

      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      const result = await submitLead({
        lead,
        honeypot: String(fd.get('website') || '').trim(),
        formLocation: form.dataset.location,
        storage: sessionStorage,
        navigate: (path: string) => { location.href = path; },
        thanksPath: form.dataset.thanks,
        send: (l: Record<string, string>) => sendLead(l, { endpoint: form.dataset.endpoint }),
        onFieldError: (field: string, code: string) => { if (!showServerFieldError(form, field, code)) status.hidden = false; },
      });
      // Definitely not saved: keep everything the visitor typed, offer phone / WhatsApp, retrying is safe.
      if (result === 'failed') status.hidden = false;
      // Unknown outcome (the lead may exist): say so, don't invite a resubmit; no conversion either way.
      if (result === 'uncertain') unsure.hidden = false;
      if (result === 'failed' || result === 'invalid' || result === 'uncertain') { btn.disabled = false; btn.removeAttribute('aria-busy'); }
    });
  });
</script>
