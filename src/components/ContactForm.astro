---
// Contact form (home page + contact page). Each lead is POSTed straight to the CRM
// webhook set in src/data/content.mjs (site.leadWebhook), then the visitor is sent to
// /thankyou, where the lead is counted for analytics (generate_lead).
//
// Payload sent to the CRM (English keys, empty values omitted):
//   full_name, email, phone, message, form ("home" | "contact"),
//   page_url, page_path, landing_page, referrer,
//   utm_source, utm_medium, utm_campaign, utm_term, utm_content, gclid, fbclid,
//   source_summary (one readable line), submitted_at (ISO time), site
import { site } from '../data/content.mjs';
interface Props { variant?: 'home' | 'page' }
const { variant = 'home' } = Astro.props;
const f = variant === 'home'
  ? { name: 'שם מלא', email: 'אימייל', phone: 'טלפון', msg: 'במה אוכל לעזור?', nameReq: true, phoneReq: true }
  : { name: 'שם', email: 'דוא"ל', phone: 'טלפון', msg: 'הודעה', nameReq: false, phoneReq: false };
const hook = site.leadWebhook ?? {};
const waHref = site.whatsapp?.number ? `https://wa.me/${site.whatsapp.number}` : null;
---
<form class="contact-form" novalidate
  data-url={hook.url} data-format={hook.format} data-mode={hook.mode}
  data-thanks={site.thankYouPath} data-to={site.email}
  data-location={variant === 'home' ? 'home' : 'contact'}>
  <!-- Spam trap: hidden from people, bots fill it in -->
  <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <label class="field">
    <span class="visually-hidden">{f.name}</span>
    <input type="text" name="full_name" placeholder={f.name} autocomplete="name" required={f.nameReq} />
  </label>
  <label class="field">
    <span class="visually-hidden">{f.email}</span>
    <input type="email" name="email" placeholder={f.email} autocomplete="email" required />
  </label>
  <label class="field">
    <span class="visually-hidden">{f.phone}</span>
    <input type="tel" name="phone" placeholder={f.phone} autocomplete="tel" required={f.phoneReq} />
  </label>
  <label class="field">
    <span class="visually-hidden">{f.msg}</span>
    <textarea name="message" rows="4" placeholder={f.msg}></textarea>
  </label>

  <button type="submit" class="send">שליחה</button>
  <p class="status" role="status" aria-live="polite" hidden>
    השליחה נכשלה. אפשר לנסות שוב, להתקשר ל-<a href={site.phoneHref} dir="ltr">{site.phone}</a>
    {waHref && <>או <a href={waHref} target="_blank" rel="noopener">לכתוב בוואטסאפ</a></>}.
  </p>
</form>

<style>
  .contact-form { display: grid; gap: 14px; width: 100%; }
  .field input, .field textarea {
    width: 100%; border: 0; border-bottom: 1px solid var(--muted); background: transparent;
    padding: 10px 2px; font-size: 16px; font-weight: 300; color: var(--ink); border-radius: 0;
  }
  .field textarea { resize: vertical; border: 1px solid var(--muted); padding: 10px; margin-top: 6px; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--ink); }
  .field :user-invalid { border-color: #b3261e; }
  .send {
    justify-self: start; background: var(--dark); color: #fff; border: 0; cursor: pointer;
    font-size: 20px; line-height: 28px; padding: 8px 48px; transition: background .2s;
  }
  .send:hover { background: #4a4848; }
  .send[disabled] { opacity: .6; cursor: wait; }
  .status { font-size: 15px; color: #b3261e; }
  .status a { text-decoration: underline; }
</style>

<script>
  const ATTR_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid', 'referrer', 'landing_page'];

  function attribution() {
    try { return JSON.parse(sessionStorage.getItem('hl_attribution') || '{}'); } catch { return {}; }
  }

  function summary(a) {
    return [
      a.utm_source && `utm_source=${a.utm_source}`,
      a.utm_medium && `utm_medium=${a.utm_medium}`,
      a.utm_campaign && `utm_campaign=${a.utm_campaign}`,
      a.gclid && 'Google Ads (gclid)',
      a.fbclid && 'Facebook / Instagram (fbclid)',
      a.referrer && `referrer: ${a.referrer}`,
      a.landing_page && `landing: ${decodeURI(a.landing_page)}`,
    ].filter(Boolean).join(' | ') || 'direct';
  }

  // countLead=false for spam: the bot sees the normal thank-you page, but no conversion is counted
  function goToThanks(form: HTMLFormElement, countLead = true) {
    if (countLead) { try { sessionStorage.setItem('hl_lead', form.dataset.location || ''); } catch {} }
    location.href = form.dataset.thanks || '/thankyou';
  }

  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.status')!;
      status.hidden = true;
      if (!form.checkValidity()) { form.reportValidity(); return; }

      const fd = new FormData(form);
      // Bots fill the hidden field: act normally but send nothing
      if (fd.get('website')) { goToThanks(form, false); return; }

      const a = attribution();
      const lead: Record<string, string> = {
        full_name: String(fd.get('full_name') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        phone: String(fd.get('phone') || '').trim(),
        message: String(fd.get('message') || '').trim(),
        form: form.dataset.location || '',
        page_url: location.href.split('#')[0],
        page_path: decodeURI(location.pathname),
        source_summary: summary(a),
        submitted_at: new Date().toISOString(),
        site: location.hostname,
      };
      for (const k of ATTR_KEYS) if (a[k]) lead[k] = k === 'landing_page' ? decodeURI(a[k]) : a[k];
      for (const k of Object.keys(lead)) if (!lead[k]) delete lead[k];

      const url = form.dataset.url;
      if (!url) {
        // Not connected to the CRM yet: open the visitor's email app (testing only)
        const body = Object.entries(lead).map(([k, v]) => `${k}: ${v}`).join('\n');
        location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent('פנייה מהאתר')}&body=${encodeURIComponent(body)}`;
        return;
      }

      const json = form.dataset.format !== 'form';
      const noCors = form.dataset.mode !== 'cors';
      const btn = form.querySelector<HTMLButtonElement>('.send')!;
      btn.disabled = true;
      try {
        const res = await fetch(url, {
          method: 'POST',
          mode: noCors ? 'no-cors' : 'cors',
          keepalive: true,
          // no-cors only allows "simple" content types, so JSON goes as text/plain there
          headers: { 'Content-Type': json ? (noCors ? 'text/plain;charset=UTF-8' : 'application/json') : 'application/x-www-form-urlencoded;charset=UTF-8' },
          body: json ? JSON.stringify(lead) : new URLSearchParams(lead).toString(),
        });
        if (!noCors && !res.ok) throw new Error(`CRM answered ${res.status}`);
        goToThanks(form);
      } catch {
        status.hidden = false;
        btn.disabled = false;
      }
    });
  });
</script>
