---
// Replaces the Wix form. Submissions go to Web3Forms, which emails them to the
// studio's Gmail. Set `web3formsKey` in src/data/content.mjs to switch it on;
// until then the form opens the visitor's email app with the message filled in.
import { site } from '../data/content.mjs';
interface Props {
  variant?: 'home' | 'page';
  thanks?: string;
}
const { variant = 'home', thanks = 'תודה שפנית אלי! אחזור אליך בהקדם' } = Astro.props;
const f = variant === 'home'
  ? { name: 'שם מלא', email: 'אימייל', phone: 'טלפון', msg: 'במה אוכל לעזור?', nameReq: true, phoneReq: true }
  : { name: 'שם', email: 'דוא"ל', phone: 'טלפון', msg: 'הודעה', nameReq: false, phoneReq: false };
const uid = `cf-${variant}`;
---
<form class="contact-form" action="https://api.web3forms.com/submit" method="POST" data-key={site.web3formsKey} data-to={site.email} data-location={variant === 'home' ? 'home' : 'contact'} novalidate>
  <input type="hidden" name="access_key" value={site.web3formsKey} />
  <input type="hidden" name="subject" value="פנייה חדשה מהאתר hagarlushi.com" />
  <input type="hidden" name="from_name" value="hagarlushi.com" />
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />
  <!-- Filled in on submit, so each lead email says where it came from -->
  <input type="hidden" name="טופס" value={variant === 'home' ? 'דף הבית' : 'דף יצירת קשר'} />
  <input type="hidden" name="נשלח מהדף" value="" data-fill="page" />
  <input type="hidden" name="מקור הגעה" value="" data-fill="source" />

  <label class="field">
    <span class="visually-hidden">{f.name}</span>
    <input type="text" name="name" placeholder={f.name} autocomplete="name" required={f.nameReq} />
  </label>
  <label class="field">
    <span class="visually-hidden">{f.email}</span>
    <input type="email" name="email" placeholder={f.email} autocomplete="email" required />
  </label>
  <label class="field">
    <span class="visually-hidden">{f.phone}</span>
    <input type="tel" name="phone" placeholder={f.phone} autocomplete="tel" required={f.phoneReq} />
  </label>
  <label class="field">
    <span class="visually-hidden">{f.msg}</span>
    <textarea name="message" rows="4" placeholder={f.msg}></textarea>
  </label>

  <button type="submit" class="send">שליחה</button>
  <p class="status" role="status" aria-live="polite" id={uid}></p>
  <p class="thanks" hidden>{thanks}</p>
</form>

<style>
  .contact-form { display: grid; gap: 14px; width: 100%; }
  .field input, .field textarea {
    width: 100%; border: 0; border-bottom: 1px solid var(--muted); background: transparent;
    padding: 10px 2px; font-size: 16px; font-weight: 300; color: var(--ink); border-radius: 0;
  }
  .field textarea { resize: vertical; border: 1px solid var(--muted); padding: 10px; margin-top: 6px; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--ink); }
  .field :user-invalid { border-color: #b3261e; }
  .send {
    justify-self: start; background: var(--dark); color: #fff; border: 0; cursor: pointer;
    font-size: 20px; line-height: 28px; padding: 8px 48px; transition: background .2s;
  }
  .send:hover { background: #4a4848; }
  .send[disabled] { opacity: .6; cursor: wait; }
  .status { font-size: 15px; min-height: 1.2em; color: #b3261e; }
  .thanks { font-size: 18px; color: var(--ink); }
</style>

<script>
  document.querySelectorAll('.contact-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.status');
      status.textContent = '';
      if (!form.checkValidity()) { form.reportValidity(); return; }

      // Lead source: first page of the visit, campaign tags and referrer (see Tracking.astro)
      let a = {};
      try { a = JSON.parse(sessionStorage.getItem('hl_attribution') || '{}'); } catch {}
      const source = [
        a.utm_source && `utm_source=${a.utm_source}`,
        a.utm_medium && `utm_medium=${a.utm_medium}`,
        a.utm_campaign && `utm_campaign=${a.utm_campaign}`,
        a.utm_term && `utm_term=${a.utm_term}`,
        a.gclid && 'Google Ads (gclid)',
        a.fbclid && 'Facebook / Instagram (fbclid)',
        a.referrer && `הפניה: ${a.referrer}`,
        a.landing_page && `דף כניסה: ${decodeURI(a.landing_page)}`,
      ].filter(Boolean).join(' | ') || 'כניסה ישירה';
      form.querySelector('[data-fill="page"]').value = decodeURI(location.pathname);
      form.querySelector('[data-fill="source"]').value = source;

      const data = new FormData(form);
      if (!form.dataset.key) {
        // No form service configured yet: fall back to the visitor's email app
        const body = `שם: ${data.get('name') || ''}\nאימייל: ${data.get('email')}\nטלפון: ${data.get('phone') || ''}\n\n${data.get('message') || ''}`;
        location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent('פנייה מהאתר')}&body=${encodeURIComponent(body)}`;
        return;
      }
      const btn = form.querySelector('.send');
      btn.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
        const json = await res.json();
        if (!json.success) throw new Error(json.message);
        // Conversion event for Google Tag Manager (GA4 key event, Google Ads, Meta Lead)
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'generate_lead', form_location: form.dataset.location, page_path: location.pathname });
        form.reset();
        form.querySelectorAll('.field, .send').forEach((el) => (el.hidden = true));
        form.querySelector('.thanks').hidden = false;
      } catch {
        status.textContent = 'השליחה נכשלה. אפשר לנסות שוב או לכתוב ישירות ל-' + form.dataset.to;
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
