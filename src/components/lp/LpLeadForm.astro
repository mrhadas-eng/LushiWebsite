---
// Landing-page consultation form ("מעוניינים בשיחת ייעוץ?"): name, phone, email and the required
// privacy-policy checkbox, as on the WordPress pages. Sends to /api/lead (same Worker contract as the
// main site, form = lp-<page>) and goes to /thankyou/ ONLY after OfficeCRM confirmed the lead.
//
// Validation (src/lib/lead-rules.js, the same rules the Worker applies): each missing or invalid field
// gets its own Hebrew message next to it, the first one is focused and nothing is sent. The separate
// delivery-failure message is shown only when a valid lead could not be delivered.
import { lpShared, lpSite, lpWhatsAppUrl } from '../../data/lp.mjs';
import { lpHref } from '../../lib/lp-paths.mjs';
import { DELIVERY_FAILED_TEXT, DELIVERY_UNCERTAIN_TEXT } from '../../lib/lead-rules.js';
import '../../styles/forms.css';
interface Props { form: string }
const { form } = Astro.props;
const L = lpShared.formLabels;
const id = (f: string) => `${form}-${f}-err`;
// "…ליצור קשר בטלפון או בוואטסאפ." with the two words linked to the landing pages' contact details.
const [failBefore, failAfter] = DELIVERY_FAILED_TEXT.split('בטלפון או בוואטסאפ');
const [unsureBefore, unsureAfter] = DELIVERY_UNCERTAIN_TEXT.split('בטלפון או בוואטסאפ');
---
<form class="lp-form" novalidate dir="rtl" data-form={form} data-thanks={lpHref('/thankyou/')}>
  <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <!-- Source order = reading and keyboard order: name, phone, email, consent, button. On desktop the grid puts the
       button at the end of the fields row and the consent line under it, as on WordPress. -->
  <div class="lp-fieldwrap" data-field>
    <label class="lp-field"><span class="form-label">{L.name}<span class="visually-hidden"> (שדה חובה)</span></span><input type="text" name="full_name" dir="rtl" required aria-required="true" aria-describedby={id('full_name')} autocomplete="name" /></label>
    <p class="lp-field-error" id={id('full_name')} data-error-for="full_name" hidden></p>
  </div>
  <div class="lp-fieldwrap" data-field>
    <label class="lp-field"><span class="form-label">{L.phone}<span class="visually-hidden"> (שדה חובה)</span></span><input type="tel" name="phone" dir="ltr" required aria-required="true" aria-describedby={id('phone')} autocomplete="tel" inputmode="tel" /></label>
    <p class="lp-field-error" id={id('phone')} data-error-for="phone" hidden></p>
  </div>
  <div class="lp-fieldwrap" data-field>
    <label class="lp-field"><span class="form-label">{L.email}<span class="visually-hidden"> (שדה חובה)</span></span><input type="email" name="email" dir="ltr" required aria-required="true" aria-describedby={id('email')} autocomplete="email" autocapitalize="off" spellcheck="false" /></label>
    <p class="lp-field-error" id={id('email')} data-error-for="email" hidden></p>
  </div>
  <div class="lp-fieldwrap lp-consent-wrap" data-field>
    <label class="lp-consent"><input type="checkbox" name="consent" value="yes" required aria-required="true" aria-describedby={id('consent')} /> <span>{lpShared.consentBefore}<a href={lpHref('/privacy/')} target="_blank" rel="noopener">{lpShared.consentLink}</a><span class="visually-hidden"> (שדה חובה)</span></span></label>
    <p class="lp-field-error" id={id('consent')} data-error-for="consent" hidden></p>
  </div>
  <button type="submit" class="lp-submit">{L.submit}</button>
  <p class="lp-form-error" role="alert" hidden>
    {failBefore}<a href={lpSite.phoneHref}>בטלפון</a> או <a href={lpWhatsAppUrl()} target="_blank" rel="noopener" data-track="lp_form_error">בוואטסאפ</a>{failAfter}
  </p>
  <p class="lp-form-error lp-form-uncertain" role="alert" hidden>
    {unsureBefore}<a href={lpSite.phoneHref}>בטלפון</a> או <a href={lpWhatsAppUrl()} target="_blank" rel="noopener" data-track="lp_form_uncertain">בוואטסאפ</a>{unsureAfter}
  </p>
</form>

<style is:global>
  /* WordPress: name, phone, email (each 278x47) and the 48px round-ended button in one row of four, 10px apart;
     the consent line under the button, on the left. Usability change (2026-10-19): the field names are permanent
     labels above the fields (white on the green band) instead of text inside the field that shrank to 11px once
     typed into; the button is lowered by the label height so it stays level with the fields. Direction and
     alignment rules shared with the main-site form: src/styles/forms.css. */
  .lp-form { display: grid; grid-template-columns: repeat(4, 1fr); column-gap: 10px; row-gap: 18px; align-items: start; }
  .lp-form .lp-submit { grid-column: 4; grid-row: 1; }
  .lp-form .lp-consent-wrap { grid-column: 4; grid-row: 2; }
  .lp-form .lp-form-error { grid-column: 1 / -1; }
  .lp-field { display: block; }
  .lp-field .form-label { font-family: 'Noto Sans Hebrew', var(--lp-font); font-size: 16px; line-height: 20px; color: #fff; margin-bottom: 6px; }
  .lp-field input { display: block; width: 100%; height: 47px; border: 1px solid rgb(105, 114, 125); border-radius: 4px; background: #fff; padding: 0 12px; font: inherit; font-size: 17px; color: var(--lp-ink); }
  .lp-field input:focus { outline: 3px solid #fff; outline-offset: 2px; }
  .lp-field input[aria-invalid="true"] { border: 2px solid #ffb4ab; box-shadow: 0 0 0 1px #8c1d18; }
  .lp-field-error { margin: 6px 2px 0; color: #fff; font-size: 14px; font-weight: 600; line-height: 1.3; }
  .lp-field-error::before { content: '⚠ '; color: #ffd8d4; }
  .lp-submit { margin-top: 26px; height: 48px; border: 0; border-radius: 36px; background: var(--lp-ink); color: #fff; font-family: 'Noto Sans Hebrew', var(--lp-font); font-size: 18px; font-weight: 600; cursor: pointer; }
  .lp-submit:hover { background: #333; }
  .lp-submit[disabled] { opacity: .6; cursor: wait; }
  .lp-consent { display: flex; gap: 8px; align-items: center; font-size: 17px; line-height: 17px; }
  .lp-consent input { width: 16px; height: 16px; margin: 0; }
  .lp-consent input:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .lp-consent input[aria-invalid="true"] { outline: 2px solid #ffb4ab; outline-offset: 2px; }
  .lp-consent a { text-decoration: underline; }
  /* Touch screens: the whole consent row is a 44px tap target, with a larger checkbox. */
  @media (pointer: coarse) {
    .lp-consent { min-height: 44px; }
    .lp-consent input { width: 22px; height: 22px; flex: none; }
    .lp-consent a { display: inline-block; padding-block: 12px; margin-block: -12px; }
  }
  .lp-form-error { margin: 0; background: #fff; color: #b3261e; padding: 8px 12px; border-radius: 4px; font-size: 15px; }
  .lp-form-error a { color: inherit; text-decoration: underline; }
  /* WordPress at 390px: one column, fields 35px tall 10px apart, the consent line, then the full-width button. */
  @media (max-width: 767px) {
    .lp-form { grid-template-columns: 1fr; row-gap: 14px; }
    .lp-form .lp-submit, .lp-form .lp-consent-wrap { grid-column: auto; grid-row: auto; }
    .lp-field input { height: 44px; }
    .lp-submit { margin-top: 6px; }
    .lp-consent { font-size: 16px; line-height: 1.4; }
  }
</style>

<script>
  import { sendLead, submitLead } from '../../lib/lead-client.js';
  import { validateForm, showServerFieldError, liveRevalidate } from '../../lib/form-ui.js';
  const ATTR = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid', 'referrer', 'landing_page'];
  document.querySelectorAll<HTMLFormElement>('.lp-form').forEach((form) => {
    liveRevalidate(form, { requireConsent: true });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = form.querySelector<HTMLElement>('.lp-form-error:not(.lp-form-uncertain)')!;
      const unsure = form.querySelector<HTMLElement>('.lp-form-uncertain')!;
      const btn = form.querySelector<HTMLButtonElement>('.lp-submit')!;
      if (btn.disabled) return;                       // a request is already in progress
      err.hidden = true;
      unsure.hidden = true;
      if (!validateForm(form, { requireConsent: true })) return;  // nothing sent, nothing counted
      const fd = new FormData(form);
      let a: Record<string, string> = {};
      try { a = JSON.parse(sessionStorage.getItem('hl_attribution') || '{}'); } catch {}
      const lead: Record<string, string> = {
        full_name: String(fd.get('full_name') || '').trim(),
        phone: String(fd.get('phone') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        consent: fd.get('consent') === 'yes' ? 'yes' : '',
        form: form.dataset.form || '',
        page_path: location.pathname,
      };
      for (const k of ATTR) if (a[k]) lead[k] = k === 'landing_page' ? decodeURI(a[k]) : a[k];
      for (const k of Object.keys(lead)) if (!lead[k]) delete lead[k];
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      const result = await submitLead({
        lead, honeypot: String(fd.get('website') || '').trim(), formLocation: form.dataset.form,
        storage: sessionStorage, navigate: (p: string) => { location.href = p; },
        thanksPath: form.dataset.thanks, send: (l: Record<string, string>) => sendLead(l),
        onFieldError: (field: string, code: string) => { if (!showServerFieldError(form, field, code)) err.hidden = false; },
      });
      if (result === 'failed') err.hidden = false;        // definitely not saved: values kept, retry is safe
      if (result === 'uncertain') unsure.hidden = false;  // the lead may exist: no resubmit invited, no conversion
      if (result === 'failed' || result === 'invalid' || result === 'uncertain') { btn.disabled = false; btn.removeAttribute('aria-busy'); }
    });
  });
</script>
