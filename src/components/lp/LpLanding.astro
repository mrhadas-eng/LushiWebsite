---
// One landing page (home / architecture / interior-design / renovation), section by section as on the
// Elementor pages: hero slideshow → "עיצוב ייחודי בהתאמה אישית" → "נעים מאוד," → testimonials carousel →
// consultation form → "פרויקטים אחרונים" gallery. Content comes from src/data/lp.mjs.
import LpLeadForm from './LpLeadForm.astro';
import { lpShared, lpImg } from '../../data/lp.mjs';
interface Props { page: (typeof import('../../data/lp.mjs'))['lpPages'][number] }
const { page } = Astro.props;
const S = lpShared;
const H = page.hero.tag;
const about = lpImg(page.about.image, 480);
const quote = lpImg('2025/02/double-quotes.svg');
const testiBg = lpImg(S.testimonialsBackground, 1600);
---
<section class="lp-hero" aria-label="פתיח">
  <div class="lp-slides" aria-hidden="true">
    {page.hero.slides.map((s, i) => { const im = lpImg(s, 1600); return <img class:list={['lp-slide', { on: i === 0 }]} src={im.src} srcset={im.srcset} sizes="100vw" alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />; })}
  </div>
  <div class="lp-hero-in">
    <H class:list={['lp-hero-title', { 'lp-hero-title--big': !page.hero.sub && !page.hero.button }]}>
      {page.hero.heading.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </H>
    {page.hero.sub && <p class="lp-hero-sub" role="heading" aria-level="2">{page.hero.sub}</p>}
    {page.hero.button && <a class="lp-btn" href="#contact">{S.cta}</a>}
    {page.hero.scrollArrow && (
      <a class="lp-down" href="#intro" aria-label="גלילה לתוכן">
        <svg viewBox="0 0 24 24" width="59" height="59" aria-hidden="true"><path d="M4 8l8 8 8-8" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
    )}
  </div>
</section>

<span id="intro" class="lp-anchor"></span>
<section class="lp-intro">
  <h2 class="lp-h2">{S.introHeading}</h2>
  <div class="lp-text">
    {page.intro.map(([b, rest]) => <p><strong>{b}</strong>{rest}</p>)}
  </div>
  <a class="lp-btn" href="#contact">{S.cta}</a>
</section>

<section class="lp-about">
  <div class="lp-about-in">
    <div class="lp-about-text">
      <h2 class="lp-h2">{S.aboutHeading}</h2>
      <p class="lp-text">{page.about.text}</p>
    </div>
    <img class="lp-about-img" src={about.src} srcset={about.srcset} sizes="290px" alt="הגר לושי" width="290" height="366" loading="lazy" />
  </div>
</section>

<section class="lp-testi" style={`--testi-bg: url('${testiBg.src}')`} aria-roledescription="carousel" aria-label={S.testimonialsHeading}>
  <h2 class="lp-h2">{S.testimonialsHeading}</h2>
  <div class="lp-testi-box">
    <button class="lp-testi-nav prev" type="button" aria-label="ההמלצה הקודמת"><svg viewBox="0 0 12 20" width="20" height="20" aria-hidden="true"><path d="M2 2l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
    <ul class="lp-testi-track">
      {S.testimonials.map((t, i) => (
        <li class="lp-testi-item" role="group" aria-roledescription="slide" aria-label={`${i + 1} מתוך ${S.testimonials.length}`}>
          <blockquote style={`--quote: url('${quote.src}')`}>
            <p>{t.text}</p>
          </blockquote>
          <p class="lp-testi-by"><cite><span class="n">{t.name}</span> <span class="p">{t.place}</span></cite></p>
        </li>
      ))}
    </ul>
    <button class="lp-testi-nav next" type="button" aria-label="ההמלצה הבאה"><svg viewBox="0 0 12 20" width="20" height="20" aria-hidden="true"><path d="M10 2L2 10l8 8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
  </div>
</section>

<span id="contact" class="lp-anchor"></span>
<section class="lp-contact">
  <h2 class="lp-h2">{S.formHeading}</h2>
  <p class="lp-text">{S.formText}</p>
  <LpLeadForm form={page.form} />
</section>

<section class="lp-gallery-sec">
  <h2 class="lp-h2">{S.galleryHeading}</h2>
  <div class="lp-gallery" data-lightbox aria-label={S.galleryHeading}>
    {page.gallery.map((g, n) => {
      const t = lpImg(g, 480); const f = lpImg(g, 1600);
      return (
        <a href={f.src} data-w={f.width} data-h={f.height} aria-label={`פתיחת תמונה ${n + 1} מתוך ${page.gallery.length}`}>
          <img src={t.src} srcset={t.srcset} sizes="(max-width: 767px) 50vw, 33vw" alt="" loading="lazy" decoding="async" />
          <span class="cap" aria-hidden="true">{S.galleryCaption}</span>
        </a>
      );
    })}
  </div>
</section>

<style>
  /* Measured on the WordPress pages at 1440px: content 1140px wide (Elementor boxed containers), headings Open Sans
     500 50/50px, text 19/28.5px. Hero 760px with a 40% black veil, title 83/83px, subtitle Tahoma 28px, 20px gaps,
     button 18px 28px padding (the hero one with a 1px white border). Sections: intro 70px padding; "נעים מאוד"
     #f9f9fa, 70px padding, 550px text beside a 290x435 photo, 60px apart; testimonials over a photo with a 70%
     #ededf0 veil, a 939px white card (text 23/36.8px italic, 50px top and left padding, 150px on the right for the
     quote mark), name and place under the card; the green form band; the gallery band (70px top). */
  .lp-anchor { display: block; position: relative; top: -10px; }
  .lp-h2 { font-family: 'Open Sans', 'Noto Sans Hebrew', sans-serif; font-weight: 500; font-size: 50px; line-height: 50px; color: var(--lp-ink); margin: 0 0 40px; text-align: center; }
  .lp-text { font-size: 19px; line-height: 28.5px; color: var(--lp-ink); text-align: center; }
  .lp-text p { margin: 0 0 10px; }
  .lp-btn { display: inline-block; background: var(--lp-ink); color: #fff !important; padding: 18px 28px; font-size: 19px; font-weight: 600; text-decoration: none; line-height: 19px; }
  .lp-btn:hover { background: #333; }

  .lp-hero { position: relative; height: 760px; overflow: hidden; color: #fff; display: grid; place-items: center; padding: 0 10px; }
  .lp-slides, .lp-slide { position: absolute; inset: 0; width: 100%; height: 100%; }
  .lp-slide { object-fit: cover; opacity: 0; transition: opacity .5s ease; }
  .lp-slide.on { opacity: 1; }
  .lp-hero::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, .4); }
  .lp-hero-in { position: relative; z-index: 1; text-align: center; display: grid; justify-items: center; gap: 20px; max-width: 1140px; }
  .lp-hero-title, .lp-hero-title--big { margin: 0; font-family: 'Open Sans', 'Noto Sans Hebrew', sans-serif; font-weight: 400; font-size: 83px; line-height: 83px; color: #fff; }
  .lp-hero-sub { margin: 0; font-family: Tahoma, 'Noto Sans Hebrew', sans-serif; font-size: 28px; line-height: 28px; }
  .lp-hero .lp-btn { border: 1px solid #fff; }
  .lp-down { color: #fff; position: absolute; bottom: -150px; left: 50%; transform: translateX(-50%); }

  .lp-intro { max-width: 1180px; margin: 0 auto; padding: 70px 20px; text-align: center; }
  .lp-intro .lp-text { margin-bottom: 40px; display: flow-root; }

  .lp-about { background: var(--lp-soft); padding: 70px 20px; }
  .lp-about-in { max-width: 1140px; margin: 0 auto; display: flex; gap: 60px; align-items: center; justify-content: center; }
  .lp-about-text { flex: 0 1 550px; }
  .lp-about-text .lp-h2 { margin-bottom: 30px; }
  .lp-about-text .lp-h2, .lp-about-text .lp-text { text-align: start; }
  .lp-about-img { width: 290px; height: 435px; object-fit: cover; flex: none; }

  .lp-testi { position: relative; padding: 100px 20px 70px; background: #fff var(--testi-bg) 0 0 / cover; }
  .lp-testi::before { content: ''; position: absolute; inset: 0; background: rgba(237, 237, 240, .7); }
  .lp-testi > * { position: relative; }
  .lp-testi .lp-h2 { margin-bottom: 30px; }
  .lp-testi-box { max-width: 1030px; margin: 0 auto; display: flex; align-items: center; gap: 0; }
  .lp-testi-track { list-style: none; margin: 0; padding: 0; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; flex: 1; }
  .lp-testi-track::-webkit-scrollbar { display: none; }
  .lp-testi-item { flex: 0 0 100%; scroll-snap-align: center; padding: 20px; }
  .lp-testi-item blockquote { margin: 0; padding: 50px 150px 50px 50px; background: #fff var(--quote) no-repeat 95% 10px / 80px auto; text-align: right; }
  .lp-testi-item blockquote p { font-size: 23px; line-height: 36.8px; font-style: italic; color: var(--lp-ink); margin: 0; }
  .lp-testi-by { margin: 25px 0 0; padding-inline: 150px 50px; text-align: right; }
  .lp-testi-by cite { font-style: normal; display: grid; color: var(--lp-ink); }
  .lp-testi-by .n { font-size: 20px; line-height: 30px; font-weight: 600; }
  .lp-testi-by .p { font-family: 'Noto Sans Hebrew', var(--lp-font); font-size: 16px; line-height: 24px; }
  .lp-testi-nav { flex: none; border: 0; background: none; color: var(--lp-ink); cursor: pointer; padding: 0; width: 26px; display: grid; place-items: center; min-height: 44px; }

  .lp-contact { background: var(--lp-green); color: #fff; padding: 70px 20px 98px; }
  .lp-contact > * { max-width: 1140px; margin-inline: auto; }
  .lp-contact .lp-h2, .lp-contact .lp-text { color: #fff; }
  .lp-contact .lp-h2 { margin-bottom: 20px; }
  .lp-contact .lp-text { margin-top: 0; margin-bottom: 34px; }

  .lp-gallery-sec { background: var(--lp-soft); padding: 70px 0 2px; }
  .lp-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .lp-gallery a { position: relative; display: block; aspect-ratio: 479 / 319; overflow: hidden; }
  .lp-gallery img { width: 100%; height: 100%; object-fit: cover; }
  .lp-gallery .cap { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(0, 0, 0, .45); color: #fff; font-size: 17px; font-weight: 600; opacity: 0; transition: opacity .3s; }
  .lp-gallery a:hover .cap, .lp-gallery a:focus-visible .cap { opacity: 1; }

  @media (max-width: 1024px) {
    .lp-hero-title, .lp-hero-title--big { font-size: 60px; line-height: 64px; }
    .lp-testi-item blockquote { padding: 50px 110px 40px 40px; }
    .lp-testi-by { padding-inline: 110px 40px; }
    .lp-gallery { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  }
  /* WordPress at 390px: sections padded 40px (20px sides), headings 36/36px (testimonials 38px, form 36/43.2px),
     text 16/24px; hero 744px, title and subtitle 48/52.8px; "נעים מאוד" centred with the 240x360 photo under the
     text; testimonials centred, 20/34px text; the gallery 2 columns. */
  @media (max-width: 767px) {
    .lp-h2 { font-size: 36px; line-height: 36px; margin-bottom: 30px; }
    .lp-text { font-size: 16px; line-height: 24px; }
    .lp-hero { height: 744px; }
    .lp-hero-title, .lp-hero-title--big { font-size: 48px; line-height: 52.8px; }
    .lp-hero-sub { font-size: 48px; line-height: 52.8px; }
    .lp-down { bottom: -110px; }
    .lp-intro { padding: 40px 20px; }
    .lp-about { padding: 40px 20px; }
    .lp-about-in { flex-direction: column; gap: 26px; }
    .lp-about-text { flex: none; }
    .lp-about-text .lp-h2 { margin-bottom: 31px; }
    .lp-about-text .lp-h2, .lp-about-text .lp-text { text-align: center; }
    .lp-about-img { width: 240px; height: 360px; }
    .lp-testi { padding: 40px 10px; }
    .lp-testi .lp-h2 { font-size: 38px; line-height: 38px; }
    .lp-testi-item { padding: 10px; }
    .lp-testi-item blockquote { padding: 50px 20px 24px; background-size: 50px auto; text-align: center; }
    .lp-testi-item blockquote p { font-size: 20px; line-height: 34px; }
    .lp-testi-by { padding-inline: 20px; text-align: center; }
    .lp-contact { padding: 40px 30px 50px; }
    .lp-contact .lp-h2 { line-height: 43.2px; }
    .lp-contact .lp-text { font-size: 19px; line-height: 28.5px; margin-bottom: 24px; }
    .lp-gallery-sec { padding-top: 40px; }
    .lp-gallery-sec .lp-h2 { margin-bottom: 30px; }
    .lp-gallery { grid-template-columns: repeat(2, 1fr); gap: 2px; }
  }
</style>

<script>
  import { initLightbox } from '../../lib/lightbox.js';
  // Hero background slideshow: fade every 2.5 s, as on the Elementor page.
  document.querySelectorAll('.lp-slides').forEach((wrap) => {
    const slides = [...wrap.querySelectorAll('.lp-slide')];
    if (slides.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0;
    setInterval(() => { slides[i].classList.remove('on'); i = (i + 1) % slides.length; slides[i].classList.add('on'); }, 2500);
  });
  // Testimonials: arrows scroll one card, looping.
  document.querySelectorAll('.lp-testi-box').forEach((box) => {
    const track = box.querySelector<HTMLElement>('.lp-testi-track')!;
    const count = track.children.length;
    const go = (dir: number) => {
      const w = track.clientWidth;
      const idx = Math.round(Math.abs(track.scrollLeft) / w);
      const next = (idx + dir + count) % count;
      track.scrollTo({ left: (getComputedStyle(track).direction === 'rtl' ? -1 : 1) * next * w, behavior: 'smooth' });
    };
    box.querySelector('.prev')?.addEventListener('click', () => go(-1));
    box.querySelector('.next')?.addEventListener('click', () => go(1));
  });
  document.querySelectorAll('.lp-gallery[data-lightbox]').forEach((g) => initLightbox(g as HTMLElement));
</script>
