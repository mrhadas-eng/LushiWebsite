---
// Square-thumbnail grid that opens a full-screen lightbox (replaces the Wix Pro Gallery)
import { img, full } from '../lib/media.mjs';
interface Props { items: { id: string; w: number; h: number }[]; label?: string }
const { items, label = 'גלריית תמונות' } = Astro.props;
---
<div class="gallery" data-lightbox aria-label={label}>
  {items.map((it, n) => {
    const t = img(it.id, 480);
    return (
      <a class="thumb" href={full(it.id)} data-w={it.w} data-h={it.h} aria-label={`פתיחת תמונה ${n + 1} מתוך ${items.length}`}>
        <img src={t.src} srcset={t.srcset} sizes="(max-width: 760px) 50vw, 240px" alt="" width="240" height="240" loading="lazy" decoding="async" />
      </a>
    );
  })}
</div>

<style>
  .gallery { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; }
  .thumb { position: relative; aspect-ratio: 1; overflow: hidden; background: #eee; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease, opacity .3s; }
  .thumb:hover img { transform: scale(1.04); opacity: .9; }
  @media (max-width: 900px) { .gallery { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  import { initLightbox } from '../lib/lightbox.js';
  document.querySelectorAll('[data-lightbox]').forEach(initLightbox);
</script>
